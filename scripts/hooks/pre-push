#!/bin/sh
set -e
echo "==> vet: linux"; go vet ./...
echo "==> vet: darwin"; GOOS=darwin go vet ./...
echo "==> vet: windows"; GOOS=windows go vet ./...
echo "==> build: darwin/arm64"; GOOS=darwin GOARCH=arm64 go build ./...
echo "==> build: windows/amd64"; GOOS=windows GOARCH=amd64 go build ./...
echo "==> test"; go test ./...
echo "==> lint"; LINT="$(go env GOPATH)/bin/golangci-lint"; \
  if [ -x "$LINT" ]; then "$LINT" run; else echo "(golangci-lint not installed, skipped)"; fi
echo "==> secrets"; command -v gitleaks >/dev/null && gitleaks detect --no-banner -v || echo "(gitleaks not installed, skipped)"
echo "OK"
